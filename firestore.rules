rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwnUserDocument(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isManager() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && currentUser().data.role in ['admin', 'counselor']
        && currentUser().data.is_active == true;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && currentUser().data.role == 'admin'
        && currentUser().data.is_active == true;
    }

    function validUserRole() {
      return request.resource.data.role in ['admin', 'counselor'];
    }

    function validSelfSignupRole() {
      return request.resource.data.role == 'counselor';
    }

    function protectedWhatsAppFieldsAbsent() {
      return !request.resource.data.keys().hasAny(['whatsapp']);
    }

    function protectedWhatsAppFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['whatsapp']);
    }

    function ownProfileFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name',
        'avatar_url',
        'notification_preferences',
        'updated_at'
      ]);
    }

    match /users/{userId} {
      allow read: if isManager() || isOwnUserDocument(userId);
      allow create: if (isOwnUserDocument(userId) && validSelfSignupRole()) || (isAdmin() && validUserRole());
      allow update: if (isAdmin() && validUserRole()) || (isOwnUserDocument(userId) && ownProfileFieldsOnly());
      allow delete: if isAdmin() && request.auth.uid != userId;
    }

    match /activity_logs/{documentId} {
      allow read: if isManager();
      allow create: if isManager();
      allow update, delete: if false;
    }

    match /{collection}/{documentId} {
      allow read: if isManager()
        && collection in [
          'inquiries',
          'students',
          'business_contacts',
          'student_education',
          'student_products',
          'meetings',
          'reminders',
          'quotations',
          'payments'
        ];

      allow create: if isManager()
        && collection in [
          'inquiries',
          'students',
          'business_contacts',
          'student_education',
          'student_products',
          'meetings',
          'reminders',
          'quotations',
          'payments'
        ]
        && (collection != 'inquiries' || protectedWhatsAppFieldsAbsent());

      allow update: if isManager()
        && collection in [
          'inquiries',
          'students',
          'business_contacts',
          'student_education',
          'student_products',
          'meetings',
          'reminders',
          'quotations',
          'payments'
        ]
        && (collection != 'inquiries' || protectedWhatsAppFieldsUnchanged());

      allow delete: if isAdmin()
        && collection in [
          'inquiries',
          'students',
          'business_contacts',
          'student_education',
          'student_products',
          'meetings',
          'reminders',
          'quotations',
          'payments'
        ];
    }
  }
}
